# Interview Copilot — environment secrets
# Copy this file to one of:
#   - .\.env                 (project root / next to the EXE)
#   - %APPDATA%\Copilot\.env
# Never commit real keys.

GROQ_API_KEY=gsk_your_groq_key_here
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Optional overrides
GEMINI_MODEL=gemini-flash-latest
GROQ_WHISPER_MODEL=whisper-large-v3
LOG_LEVEL=INFO

# Optional free-tier usage caps (UI warns near these; defaults match common free tiers)
# GROQ_RPM_LIMIT=20
# GEMINI_RPM_LIMIT=15
# GEMINI_DAILY_LIMIT=250
